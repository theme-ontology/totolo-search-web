{
  "name": "totolo-search-web",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "build:core": "npm run build --workspace=packages/core",
    "build:indexer": "npm run build --workspace=packages/indexer",
    "build:web": "npm run build --workspace=packages/web",
    "build": "npm run build:core && npm run build:indexer && npm run build:web",
    "dev": "npm run dev --workspace=packages/web",
    "index": "npm run index --workspace=packages/indexer",
    "dev:local": "node scripts/dev.mjs",
    "dev:local:skip-corpus": "node scripts/dev.mjs --skip-corpus",
    "dev:local:skip-index": "node scripts/dev.mjs --skip-index"
  }
}
